# Native model profile used by the 2026-10-16 matched comparison.
# Load with: set -a; . configs/benchmark-native-b300.env; set +a
# No expert pruning or new lossy quantization. See docs/current-results.md.
DRAMA3_GDN_STATE_DTYPE=bfloat16
DRAMA3_PREFILL_GDN=fla
DRAMA3_PACKED_MOE_PROJECTION=1
DRAMA3_PREFILL_CONV=triton
DRAMA3_PREFILL_MOE_TUNED=0
DRAMA3_PREFILL_MOE=flashinfer
DRAMA3_ADMISSION_MIN_BATCH=6
DRAMA3_PREFILL_BUCKET_192=1
DRAMA3_PACKED_PREFILL=1
DRAMA3_ASYNC_CODEC=1
DRAMA3_AUDIO_DELIVERY_THREAD=1
DRAMA3_FUSED_MOE_INPUT=1
DRAMA3_MIXED_BACKBONE=1
DRAMA3_MIXED_SPAN256=1
DRAMA3_CODEC_DEDICATED_CAPTURE_STREAM=1
DRAMA3_COMPACT_GDN=1
DRAMA3_FUSED_MIXED_LAYOUT=1
DRAMA3_PACKED_CONV_GUARD=1
DRAMA3_DEFER_CODEC_SUBMIT=0
DRAMA3_CODEC_SPLIT_POLICY=dp
DRAMA3_SHORT_PADDING_CONTEXT=1
DRAMA3_FUSED_MOE_RESIDUAL=1
DRAMA3_CODEC_SMS=0
DRAMA3_RESERVED_PADDING_ROUTER=1
DRAMA3_FRAME_PIPELINE=1
DRAMA3_FRAME_PIPELINE_DEFERRED_WAITING=1
DRAMA3_CODEC_CACHED_LINEAR=0
DRAMA3_CODEC_COALESCE=0
DRAMA3_MIXED_ROW_REUSE=0
